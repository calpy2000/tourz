# Committed (not gitignored) production Vite config — unlike .env.local, this ships in the
# public repo and is picked up automatically by any `vite build` run in "production" mode,
# including Cloudflare's own build step, with no Cloudflare dashboard env var needed.
#
# Turned back off 2026-09-04 so the live app requires real registration (testing the actual
# join flow with a real game code) instead of auto-logging every visitor in as the dev team.
# Was on since 2026-09-02 to capture GPS corrections directly on the deployed site — see git
# history for that rationale if it needs to go back on.
VITE_DEV_MODE=false
