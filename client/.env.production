# Committed (not gitignored) production Vite config — unlike .env.local, this ships in the
# public repo and is picked up automatically by any `vite build` run in "production" mode,
# including Cloudflare's own build step, with no Cloudflare dashboard env var needed.
#
# Deliberately on for the live app right now at the user's own request, so GPS corrections can be
# captured directly on the deployed site (dev auto-login via the seeded DEV-LOCAL game code, the
# Dev menu, and the drag-to-set-GPS flow). This also means any visitor to the live URL gets
# auto-logged-in as the same seeded team and can see the Dev menu (including Reset/Complete
# actions that touch that team's live progress) — acceptable while the app isn't shared beyond
# the user's own team, but turn this back off (delete this file or set to false) before wider use.
VITE_DEV_MODE=true
