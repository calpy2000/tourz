# Committed (not gitignored) production Vite config — unlike .env.local, this ships in the
# public repo and is picked up automatically by any `vite build` run in "production" mode,
# including Cloudflare's own build step — UNLESS Cloudflare's dashboard has its own
# Settings -> Builds -> Variables and secrets entry for VITE_DEV_MODE, which silently wins over
# this file on Cloudflare's own builds. Keep both in sync when changing this.
#
# Turned back ON 2026-09-04 (again) at the user's request.
VITE_DEV_MODE=true
